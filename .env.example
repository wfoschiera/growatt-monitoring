# InfluxDB
INFLUXDB_ADMIN_USERNAME=admin
INFLUXDB_ADMIN_PASSWORD=change_me
INFLUXDB_ORG=home
INFLUXDB_BUCKET=solar
INFLUXDB_RETENTION=0
# Gere com: openssl rand -hex 32
INFLUXDB_ADMIN_TOKEN=replace_with_openssl_rand_hex_32

# Grafana
GRAFANA_ADMIN_PASSWORD=change_me

# MQTT (Telegraf consumindo do Mosquitto)
MQTT_TELEGRAF_USER=telegraf
MQTT_TELEGRAF_PASSWORD=change_me

# MQTT (stick publicando — usado só no mosquitto_passwd, não pelos containers)
MQTT_GROWATT_USER=growatt
MQTT_GROWATT_PASSWORD=change_me
